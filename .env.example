# copy to .env (git-ignored). Everything is optional; defaults use the public mainnet RPC.
# ITB_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# ITB_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# ITB_SEND_URL=            # where sendTransaction goes (default: ITB_RPC_URL)
# ITB_BLOCK_INTERVAL=0.25  # seconds between getBlock calls; 1.5 for the public RPC
# ITB_SECRET_KEY=          # base58 secret key, instead of secrets/keypair.json
# ITB_SECRETS=/abs/path/to/folder/with/keypair.json
